{
  "name": "@usespaceui/ui",
  "version": "0.0.13",
  "private": true,
  "description": "The official Space UI website, documentation, and component registry.",
  "author": {
    "name": "SpaceUI",
    "email": "hello@spaceui.one",
    "url": "https://www.spaceui.one"
  },
  "contributors": [
    {
      "name": "SpaceUI Team",
      "email": "hello@spaceui.one",
      "url": "https://www.spaceui.one"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/usespaceui"
  },
  "license": "MIT",
  "homepage": "https://www.spaceui.one",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usespaceui/ui.git"
  },
  "bugs": {
    "url": "https://github.com/usespaceui/ui/issues",
    "email": "hello@spaceui.one"
  },
  "keywords": [
    "spaceui",
    "react",
    "nextjs",
    "tailwind",
    "components",
    "registry",
    "documentation",
    "design-system"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "clean": "pnpm registry:clean && pnpm registry:build",
    "registry:build": "pnpm registry:style && tsx ./scripts/build-registry.ts && pnpm format:write",
    "registry:style": "pnpm sync:style && pnpm format:write",
    "registry:clean": "tsx ./scripts/clean-registry-items.ts",
    "sync:style": "tsx ./scripts/sync-globals-css.ts",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format:write": "prettier --write \"{src,public,scripts,supabase}/**/*.{ts,tsx,json,css,mdx}\" --cache",
    "format:check": "prettier --check \"{src,public,scripts,supabase}/**/*.{ts,tsx,json,css,mdx}\" --cache",
    "launch": "node scripts/launch-render.mjs",
    "launch:all": "pnpm launch && pnpm launch --res 4k",
    "cards": "node scripts/cards-render.mjs"
  },
  "dependencies": {
